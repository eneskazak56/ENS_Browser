<Application x:Class="ENSBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#0F172A" />
    <SolidColorBrush x:Key="PanelBackground" Color="#172033" />
    <SolidColorBrush x:Key="PanelBorder" Color="#2B3954" />
    <SolidColorBrush x:Key="PrimaryText" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SecondaryText" Color="#A8B4C7" />
    <SolidColorBrush x:Key="Accent" Color="#60A5FA" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
  </Application.Resources>
</Application>
