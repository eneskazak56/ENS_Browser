<Window x:Class="ENSBrowser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ENS Browser settings" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock Grid.Row="1" Text="Home page" Margin="0,0,0,4"/>
    <TextBox x:Name="HomePageBox" Grid.Row="2" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Search engine" VerticalAlignment="Center" Width="120"/>
      <ComboBox x:Name="SearchEngineBox" Width="220">
        <ComboBoxItem Content="Google"/>
        <ComboBoxItem Content="DuckDuckGo"/>
        <ComboBoxItem Content="Brave"/>
      </ComboBox>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Theme" VerticalAlignment="Center" Width="120"/>
      <ComboBox x:Name="ThemeBox" Width="220">
        <ComboBoxItem Content="Dark"/>
        <ComboBoxItem Content="Light"/>
      </ComboBox>
    </StackPanel>
    <TextBlock Grid.Row="5" Text="Privacy" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <CheckBox x:Name="SaveHistoryBox" Grid.Row="6" Content="Save browsing history locally" Margin="0,0,0,6"/>
    <CheckBox x:Name="ClearHistoryBox" Grid.Row="7" Content="Clear browsing history when the browser closes" Margin="0,0,0,6"/>
    <CheckBox x:Name="TrackingPreventionBox" Grid.Row="8" Content="Use balanced tracking prevention" Margin="0,0,0,6"/>
    <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Click="Cancel_Click" Width="90"/>
      <Button Content="Save" Click="Save_Click" Width="90" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
