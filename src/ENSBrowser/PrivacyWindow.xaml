<Window x:Class="ENSBrowser.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ENS Browser privacy" Width="580" Height="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Privacy controls" FontSize="24" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,18,0,0">
      <CheckBox x:Name="TrackingBox" Content="Use balanced tracking prevention" IsChecked="True" Margin="0,0,0,12"/>
      <CheckBox x:Name="ClearOnExitBox" Content="Clear Chromium browsing data when the app closes" Margin="0,0,0,12"/>
      <CheckBox Content="Disable password autosave" IsChecked="True" IsEnabled="False" Margin="0,0,0,12"/>
      <CheckBox Content="Disable general autofill" IsChecked="True" IsEnabled="False" Margin="0,0,0,12"/>
      <TextBlock Text="ENS Browser cannot make websites anonymous. These controls reduce local persistence and apply Chromium privacy settings." TextWrapping="Wrap" Opacity="0.8"/>
      <Button Content="Clear current Chromium data" HorizontalAlignment="Left" Margin="0,18,0,0" Click="ClearData_Click"/>
      <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Apply" Click="Apply_Click"/>
      <Button Content="Close" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
